<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>obj_detection</name>
  <version>0.0.0</version>
  <description>apple-care 사과 상태(정상/썩음/손상) 인식 노드</description>
  <maintainer email="pfr0213@gmail.com">root</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- Humble의 cv_bridge는 numpy2와 호환이 안 돼 ros_image_utils.py가 자체
       구현으로 우회함 (건너뜀). Jazzy 이후는 cv_bridge 그대로 사용. -->
  <exec_depend condition="$ROS_DISTRO != 'humble'">cv_bridge</exec_depend>
  <exec_depend>apple_care_msgs</exec_depend>
  <exec_depend>python3-pymodbus</exec_depend>
  <!-- prepare_camera.py는 로봇 이동을 위해 DSR_ROBOT2를 가져다 씀. 이건 colcon
       패키지가 아니라 로봇 쪽 워크스페이스(robot_ws)가 source된 셸 환경에서만
       import 가능하므로, 실행 전에 robot_ws도 반드시 빌드/소싱되어 있어야 함
       (실행.txt의 p2() 참고). 그리퍼 제어는 gripper_control.py에 이 패키지
       자체 코드로 있어서 apple_care_robot을 import하지는 않음. -->


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
